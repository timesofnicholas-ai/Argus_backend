# Redis
REDIS_URL=redis://localhost:6379

# Postgres (Supabase connection string, session mode)
DATABASE_URL=postgresql://postgres:[password]@db.suqgzcasipleoguemwre.supabase.co:5432/postgres

# Groq (OpenAI-compatible API — see https://console.groq.com for current free-tier limits)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# --- LLM quota ---
# Defaults below are placeholders, not confirmed Groq limits — check your
# actual free-tier RPM/RPD on console.groq.com and set these to match.
# Do not raise past your actual plan limits — raise the plan first, then these.
LLM_RPM_LIMIT=30
LLM_RPD_LIMIT=1000
LLM_RPD_RESERVED_FOR_BRIEF=10   # reserve some calls/day for WF-08, rest go to enrichment

# enqueue-api
ENQUEUE_API_PORT=3001

# Admin endpoint auth
ADMIN_API_KEY=change_me
ADMIN_CORS_ORIGIN=*

# Worker concurrency
CLEANING_CONCURRENCY=20
ENTITY_RESOLUTION_CONCURRENCY=10

# LLM batching
LLM_BATCH_SIZE=30
LLM_BATCH_WINDOW_MS=30000
